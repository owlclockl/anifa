{
  "name": "quiet-notes",
  "version": "1.0.0",
  "description": "A simple desktop notes app",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5174",
    "electron:dev": "vite --host 0.0.0.0 --port 5174 & sleep 3 && electron .",
    "dist": "npm run build && electron-builder --win --mac --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.owlclockl.quiet-notes",
    "productName": "Quiet Notes",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "release"
    }
  },
  "author": "Quiet Notes"
}
